{
  "name": "ras-control-center",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && node server/index.mjs",
    "serve": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "demo": "node scripts/demo.mjs",
    "test:ui": "npm run build && playwright test",
    "verify:clean": "node scripts/verify-clean.mjs",
    "format": "prettier --write client server scripts tests docs README.md package.json"
  },
  "dependencies": {
    "dotenv": "^17.2.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.35.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.43.0",
    "vite": "^7.1.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
